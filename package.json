{
  "name": "prompt-pal-backend",
  "version": "1.0.0",
  "description": "Backend API for Prompt Pal",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src",
    "seed:admin": "tsx src/_seeder/admin.seeder.ts",
    "migrate:moderation": "tsx src/_migrations/add-moderation-fields.migration.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:prompt-slugs": "tsx src/_migrations/add-prompt-slugs.migration.ts",
    "migrate:prompt-versions": "tsx src/_migrations/add-prompt-versions.migration.ts"
  },
  "keywords": [
    "prompt-pal",
    "api",
    "express",
    "mongodb",
    "typescript"
  ],
  "author": "CCTechEt",
  "license": "ISC",
  "packageManager": "pnpm@10.19.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@google/genai": "^2.30.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "isomorphic-dompurify": "^4.5.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5",
    "mongoose-sanitize": "^1.5.0",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^10.1.2",
    "pino": "^10.4.0",
    "posthog-node": "^5.56.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.35",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
